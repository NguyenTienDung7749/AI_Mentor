<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.AIMentor.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.AIMentor.Card.Highlight" parent="Widget.AIMentor.Card">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="strokeColor">?attr/colorPrimaryContainer</item>
    </style>

    <style name="Widget.AIMentor.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/control_corner_radius</item>
    </style>

    <style name="Widget.AIMentor.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <style name="Widget.AIMentor.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="boxCornerRadiusTopStart">@dimen/control_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/control_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/control_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/control_corner_radius</item>
    </style>

    <style name="TextAppearance.AIMentor.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AIMentor.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AIMentor.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.AIMentor.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AIMentor.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.AIMentor.Supporting" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.AIMentor.BottomNavigation"
        parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.AIMentor.NavigationIndicator</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">10dp</item>
    </style>

    <style name="Widget.AIMentor.NavigationIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorSecondaryContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.AIMentor.Pill</item>
    </style>

    <style name="ShapeAppearance.AIMentor.Pill" parent="ShapeAppearance.Material3.Corner.Full" />

    <style name="Widget.AIMentor.SegmentedButton"
        parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
