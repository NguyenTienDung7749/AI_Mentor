<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationContentDescription="@string/close_screen"
        app:navigationIcon="@drawable/ic_close_24"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/practice_quiz_title"
        app:titleTextColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/quiz_loading"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/quizProgressIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_sm"
        android:max="5"
        android:progress="0"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceVariant"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/quizLoadingState"
        style="@style/Widget.AIMentor.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/card_padding">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvQuizStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/quiz_loading"
                android:textAppearance="@style/TextAppearance.AIMentor.Supporting" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/quizErrorState"
        style="@style/Widget.AIMentor.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_padding"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorErrorContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/tvQuizError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/quiz_error_default"
                android:textColor="?attr/colorOnErrorContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryQuiz"
                style="@style/Widget.AIMentor.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/retry_quiz_loading" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quizContent"
                style="@style/Widget.AIMentor.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/tvQuizType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_info_panel"
                        android:paddingHorizontal="@dimen/space_md"
                        android:paddingVertical="@dimen/space_xs"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQuestionPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:lineSpacingExtra="1dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl">

                        <RadioButton
                            android:id="@+id/rbOpt0"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/space_md"
                            android:background="@drawable/bg_quiz_option"
                            android:buttonTint="@color/quiz_option_tint"
                            android:minHeight="60dp"
                            android:padding="@dimen/space_lg"
                            android:textColor="?attr/colorOnSurface" />

                        <RadioButton
                            android:id="@+id/rbOpt1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/space_md"
                            android:background="@drawable/bg_quiz_option"
                            android:buttonTint="@color/quiz_option_tint"
                            android:minHeight="60dp"
                            android:padding="@dimen/space_lg"
                            android:textColor="?attr/colorOnSurface" />

                        <RadioButton
                            android:id="@+id/rbOpt2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/space_md"
                            android:background="@drawable/bg_quiz_option"
                            android:buttonTint="@color/quiz_option_tint"
                            android:minHeight="60dp"
                            android:padding="@dimen/space_lg"
                            android:textColor="?attr/colorOnSurface" />

                        <RadioButton
                            android:id="@+id/rbOpt3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_quiz_option"
                            android:buttonTint="@color/quiz_option_tint"
                            android:minHeight="60dp"
                            android:padding="@dimen/space_lg"
                            android:textColor="?attr/colorOnSurface" />
                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textAnswerLayout"
                        style="@style/Widget.AIMentor.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl"
                        android:hint="@string/quiz_type_answer_hint"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTextAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textCapSentences"
                            android:maxLength="160"
                            android:maxLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:background="@drawable/bg_info_panel"
                        android:lineSpacingExtra="2dp"
                        android:padding="@dimen/space_lg"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_lg"
        android:enabled="false"
        android:text="@string/check_answer"
        android:textSize="16sp" />
</LinearLayout>
