<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_title"
            android:textColor="@color/primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/education_level"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton android:id="@+id/rbMiddle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Middle School" />
            <RadioButton android:id="@+id/rbHigh" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:checked="true" android:text="High School" />
            <RadioButton android:id="@+id/rbUniversity" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="University" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/subjects_interest"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox android:id="@+id/cbMath" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Mathematics" />
        <CheckBox android:id="@+id/cbScience" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Science" />
        <CheckBox android:id="@+id/cbProgramming" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Programming" />
        <CheckBox android:id="@+id/cbHistory" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="History" />
        <CheckBox android:id="@+id/cbLanguages" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Languages" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/explanation_style"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton android:id="@+id/rbShort" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Short" />
            <RadioButton android:id="@+id/rbDetailed" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Detailed" />
            <RadioButton android:id="@+id/rbStep" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:checked="true" android:text="Step-by-step" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingVertical="12dp"
            android:text="@string/get_started"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
